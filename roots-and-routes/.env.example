# Vercel Blob Storage Configuration
# Get your token from https://vercel.com/dashboard/storage/blob
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Application Configuration
NODE_ENV=development
APP_NAME=Roots & Routes
APP_URL=http://localhost:3000

# Map Configuration (Optional - for custom tile layers)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# GEDCOM Processing
GEDCOM_MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/gedcom

# Vercel Deployment
VERCEL_TOKEN=your_vercel_deployment_token
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id

# Database (Optional - for future expansion)
DATABASE_URL=postgresql://user:password@localhost:5432/roots-and-routes
