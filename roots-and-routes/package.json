    "@nuxtjs/tailwindcss": "^6.14.0",
    "@nuxtjs/color-mode": "^3.4.0",
    "@types/leaflet": "^1.9.12",
    "@types/uuid": "^9.0.8",
    "@vueuse/core": "^10.11.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-vue": "^9.22.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0",
    "vercel": "^35.0.0",
